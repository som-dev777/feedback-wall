{
  "name": "feedback-wall",
  "private": true,
  "description": "A live digital sticky-note board",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm ci --prefix server && npm ci --include=dev --prefix client && npm run build --prefix client",
    "start": "npm start --prefix server",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:nft": "playwright test -c playwright.nft.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4"
  }
}
